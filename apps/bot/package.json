{
  "name": "@nbenhadi/mirror-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/index.ts",
    "register": "tsx --env-file=../../.env src/register.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean --sourcemap",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.17.3"
  },
  "devDependencies": {
    "@nbenhadi/mirror-config": "workspace:*",
    "@nbenhadi/mirror-core": "workspace:*",
    "@nbenhadi/mirror-i18n": "workspace:*",
    "@nbenhadi/mirror-password": "workspace:*",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
